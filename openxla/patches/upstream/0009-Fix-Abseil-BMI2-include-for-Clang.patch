From 5d5aced9913c035e7720af3a864a7bae97bc7faa Mon Sep 17 00:00:00 2001
From: Hugo Mano <hugo@zml.ai>
Date: Fri, 3 Jul 2026 09:38:51 +0200
Subject: [PATCH 9/9] Fix Abseil BMI2 include for Clang

---
 MODULE.bazel                      | 1 +
 third_party/absl/bmi2intrin.patch | 8 ++++++++
 third_party/absl/workspace.bzl    | 1 +
 3 files changed, 10 insertions(+)
 create mode 100644 third_party/absl/bmi2intrin.patch

diff --git a/MODULE.bazel b/MODULE.bazel
index 00bbc0e620..24faf6bc1b 100644
--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -75,6 +75,7 @@ single_version_override(
         "//third_party/absl:btree.patch",
         "//third_party/absl:build_dll.patch",
         "//third_party/absl:endian.patch",
+        "//third_party/absl:bmi2intrin.patch",
     ],
 )
 
diff --git a/third_party/absl/bmi2intrin.patch b/third_party/absl/bmi2intrin.patch
new file mode 100644
index 0000000000..7110a9151e
--- /dev/null
+++ b/third_party/absl/bmi2intrin.patch
@@ -0,0 +1,8 @@
+diff --git a/absl/container/internal/raw_hash_set.h b/absl/container/internal/raw_hash_set.h
+--- a/absl/container/internal/raw_hash_set.h
++++ b/absl/container/internal/raw_hash_set.h
+@@ -228,3 +228,3 @@
+ #ifdef __BMI2__
+-#include <bmi2intrin.h>
++#include <immintrin.h>
+ #endif  // __BMI2__
diff --git a/third_party/absl/workspace.bzl b/third_party/absl/workspace.bzl
index cf6a25b136..e7dc3c59eb 100644
--- a/third_party/absl/workspace.bzl
+++ b/third_party/absl/workspace.bzl
@@ -20,6 +20,7 @@ def repo():
             "//third_party/absl:btree.patch",
             "//third_party/absl:build_dll.patch",
             "//third_party/absl:endian.patch",
+            "//third_party/absl:bmi2intrin.patch",
         ],
         repo_mapping = {
             "@google_benchmark": "@com_google_benchmark",
